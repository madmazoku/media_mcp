{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp_video_run_scenario.json",
  "title": "MCP Tool Arguments: video_run_scenario",
  "description": "Execute a hierarchical multi-scene video scenario with Wan 2.2 or LTX-2.3 (22B) using Latent-Chaining and lossless Stream Copy assembly.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["scenario_path"] },
    { "required": ["scenario_data"] }
  ],
  "properties": {
    "scenario_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to scenario JSON file (in workflows/ or absolute)"
    },
    "scenario_data": {
      "$ref": "scenario.json",
      "description": "Hierarchical scenario object matching scenario.json"
    },
    "image": {
      "$ref": "scenario.json#/$defs/image_config",
      "description": "Global anchor image configuration override"
    },
    "video": {
      "$ref": "scenario.json#/$defs/video_config",
      "description": "Global video configuration override"
    },
    "enable_hud": {
      "type": "boolean",
      "default": false,
      "description": "Generate debug video with countdown timeline overlay"
    }
  }
}
