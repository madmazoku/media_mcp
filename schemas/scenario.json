{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.json",
  "title": "Media MCP Video Scenario",
  "description": "Strict hierarchical Scene -> Blocks video scenario schema with unified naming conventions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "scenario_path": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path to a base scenario file on disk to inherit and overlay from"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable scenario title"
    },
    "image": {
      "$ref": "#/$defs/image_root_config"
    },
    "video": {
      "$ref": "#/$defs/video_root_config"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      },
      "description": "Ordered list of montage scenes"
    }
  },
  "$defs": {
    "image_root_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["sdxl", "flux1", "flux2"],
          "default": "sdxl",
          "description": "Anchor image generation engine"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model filename or identifier"
        },
        "prompt": {
          "type": "string",
          "description": "Base visual prompt inherited by scene anchor frames"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative prompt (SDXL only)"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "guidance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "denoise": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0,
          "default": 0.65,
          "description": "Default img2img denoising strength for anchor frames"
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lora_item"
          }
        }
      }
    },
    "video_root_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["wan-fast", "wan-full", "ltx"],
          "default": "wan-fast",
          "description": "Video generation engine"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Video checkpoint model name"
        },
        "prompt": {
          "type": "string",
          "description": "Base motion prompt inherited by all blocks"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Base negative prompt inherited by all blocks"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16,
          "default": 832
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16,
          "default": 480
        },
        "fps": {
          "type": "integer",
          "enum": [16, 24, 25, 30, 60],
          "default": 16
        },
        "max_duration": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 60.0,
          "default": 15.0
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lora_item"
          }
        }
      }
    },
    "lora_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "LoRA model name or filename"
        },
        "strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "default": 0.8,
          "description": "LoRA weight strength"
        }
      }
    },
    "anchor_image": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["image_path"] },
        { "required": ["prompt"] }
      ],
      "properties": {
        "image_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to an existing anchor keyframe image on disk (for ready keyframe or img2img refinement)"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Visual prompt text describing the scene appearance"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative prompt (SDXL only, concatenated with global negative_prompt)"
        },
        "denoise": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0,
          "description": "Denoising strength for img2img refinement of this scene's anchor frame (overrides global image.denoise)"
        },
        "seed": {
          "type": "integer",
          "minimum": -1,
          "description": "Optional scene-specific random seed (-1 for randomized)"
        },
        "loras": {
          "type": "array",
          "description": "Scene-specific LoRAs to merge with global image.loras",
          "items": {
            "$ref": "#/$defs/lora_item"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_prompt"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Descriptive title for this video block"
        },
        "duration": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30.0,
          "default": 5.0,
          "description": "Duration in seconds for this block"
        },
        "overlap": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 5.0,
          "default": 0.0,
          "description": "Tail latent overlap duration into subsequent block"
        },
        "motion_prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Action and camera dynamics prompt"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Block-specific negative prompt"
        },
        "engine": {
          "type": "string",
          "enum": ["wan-fast", "wan-full", "ltx"],
          "description": "Block-level video generator engine override"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Block-level model override"
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lora_item"
          }
        },
        "weight_dtype": {
          "type": "string",
          "enum": ["default", "fp8_e4m3fn", "fp8_e5m2"]
        },
        "ramp_latents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "min_cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_image", "blocks"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Descriptive scene title"
        },
        "engine": {
          "type": "string",
          "enum": ["wan-fast", "wan-full", "ltx"],
          "description": "Scene-level default video engine"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Scene-level default model"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Scene-level negative prompt"
        },
        "anchor_image": {
          "$ref": "#/$defs/anchor_image"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          },
          "description": "Ordered sequence of motion blocks inside this scene"
        }
      }
    }
  }
}
