{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media_get_samplers.json",
  "title": "media_get_samplers",
  "description": "Inspect compatible samplers for a specific engine and model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["engine", "model"],
  "properties": {
    "engine": {
      "type": "string",
      "minLength": 1,
      "description": "Engine name (e.g. 'sdxl', 'flux1', 'wan-fast')"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model filename or identifier"
    }
  }
}
