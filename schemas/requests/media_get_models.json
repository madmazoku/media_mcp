{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media_get_models.json",
  "title": "media_get_models",
  "description": "Inspect available checkpoint and UNET models across engines.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["image", "video"],
      "description": "Optional filter by media kind"
    },
    "engine": {
      "type": "string",
      "enum": ["sdxl", "sdxl-comfy", "flux1", "flux2", "wan-fast", "wan-full", "ltx", "hunyuan"],
      "description": "Optional filter by engine ('sdxl', 'sdxl-comfy', 'flux1', 'flux2', 'wan-fast', 'wan-full', 'ltx', 'hunyuan')"
    }
  }
}
