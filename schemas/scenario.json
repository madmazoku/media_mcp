{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.json",
  "title": "Media MCP Video Scenario",
  "description": "Strict hierarchical Scene -> Blocks video scenario schema with engine-specific validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Optional human-readable scenario title (used for logging only; output files always follow the server hyphen template)"
    },
    "image": {
      "$ref": "#/$defs/image_config"
    },
    "video": {
      "$ref": "#/$defs/video_config"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      },
      "description": "Ordered list of montage scenes"
    }
  },
  "$defs": {
    "image_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["sdxl", "flux1", "flux2"],
          "default": "sdxl",
          "description": "Anchor image generation engine"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Checkpoint model name"
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit checkpoint filename"
        },
        "prompt": {
          "type": "string",
          "description": "Base visual prompt inherited by scene anchor frames"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative prompt (SDXL only)"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "guidance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "lora": {
          "type": "string",
          "minLength": 1
        },
        "lora_strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": { "enum": ["flux1", "flux2"] }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["negative_prompt"] },
                { "required": ["sampler"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine": { "const": "flux2" }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "required": ["lora"]
            }
          }
        }
      ]
    },
    "anchor_image": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["image_path"] },
        { "required": ["prompt"] }
      ],
      "properties": {
        "image_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to an existing anchor keyframe image on disk"
        },
        "engine": {
          "type": "string",
          "enum": ["sdxl", "flux1", "flux2"],
          "description": "Anchor image generation engine"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Checkpoint model name"
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit checkpoint filename"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Visual appearance prompt for generating the scene anchor frame"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative prompt (SDXL only)"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "guidance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "lora": {
          "type": "string",
          "minLength": 1
        },
        "lora_strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": { "enum": ["flux1", "flux2"] }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["negative_prompt"] },
                { "required": ["sampler"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine": { "const": "flux2" }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "required": ["lora"]
            }
          }
        }
      ]
    },
    "video_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["wan-fast", "wan", "ltx"],
          "default": "wan-fast",
          "description": "Video diffusion engine ('wan-fast' default, 'wan' full 20-step, 'ltx' LTX-2.3 22B)"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_low": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "description": "Global base motion/style prompt inherited by all blocks"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Global negative prompt inherited by scenes and blocks"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16,
          "default": 832
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16,
          "default": 480
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 16
        },
        "max_duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 10.0,
          "description": "Maximum single-pass generation window (prefix_duration + clip_duration < max_duration)"
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "lora_name": {
          "type": "string",
          "minLength": 1
        },
        "lora_strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "weight_dtype": {
          "type": "string",
          "enum": ["default", "fp8_e4m3fn", "fp8_e4m3fn_fast", "fp8_e5m2"]
        },
        "ramp_latents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "min_cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": { "const": "ltx" }
            },
            "required": ["engine"]
          },
          "then": {
            "properties": {
              "width": { "multipleOf": 32 },
              "height": { "multipleOf": 32 }
            },
            "not": {
              "anyOf": [
                { "required": ["checkpoint_low"] },
                { "required": ["ramp_latents"] },
                { "required": ["min_cfg"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine": { "enum": ["wan-fast", "wan"] }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["lora_name"] },
                { "required": ["lora_strength"] },
                { "required": ["weight_dtype"] }
              ]
            }
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_image", "blocks"],
      "properties": {
        "scene_name": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "enum": ["wan-fast", "wan", "ltx"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "negative_prompt": {
          "type": "string"
        },
        "anchor_image": {
          "$ref": "#/$defs/anchor_image"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_prompt"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 5.0,
          "description": "Clip duration in seconds (must satisfy prefix_duration + clip_duration < max_duration)"
        },
        "overlap": {
          "type": "number",
          "minimum": 0.0,
          "default": 0.0,
          "description": "Tail overlap duration in seconds passed as prefix to the next block (must satisfy overlap < duration)"
        },
        "motion_prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Action and camera trajectory prompt for this block"
        },
        "negative_prompt": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "enum": ["wan-fast", "wan", "ltx"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "lora_strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "weight_dtype": {
          "type": "string",
          "enum": ["default", "fp8_e4m3fn", "fp8_e4m3fn_fast", "fp8_e5m2"]
        },
        "ramp_latents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "min_cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": { "const": "ltx" }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["ramp_latents"] },
                { "required": ["min_cfg"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine": { "enum": ["wan-fast", "wan"] }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["lora_strength"] },
                { "required": ["weight_dtype"] }
              ]
            }
          }
        }
      ]
    }
  }
}
