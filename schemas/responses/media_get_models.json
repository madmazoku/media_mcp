{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media_get_models.json",
  "title": "Media Get Models Response Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdxl": { "type": "array", "items": { "type": "string" } },
        "flux1": { "type": "array", "items": { "type": "string" } },
        "flux2": { "type": "array", "items": { "type": "string" } }
      },
      "description": "Installed checkpoint and UNET models grouped by image engine"
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wan-fast": { "type": "array", "items": { "type": "string" } },
        "wan-full": { "type": "array", "items": { "type": "string" } },
        "ltx": { "type": "array", "items": { "type": "string" } }
      },
      "description": "Installed UNET and video model bundles grouped by video engine"
    }
  }
}
