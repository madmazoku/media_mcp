{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loras_spec.json",
  "title": "LoRA List Specification",
  "description": "Optional list of LoRAs to apply in order",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "LoRA model name or filename"
      },
      "strength": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 2.0,
        "default": 0.8,
        "description": "LoRA weight strength"
      }
    }
  }
}
