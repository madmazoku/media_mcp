{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media_get_samplers.json",
  "title": "media_get_samplers",
  "description": "Inspect compatible samplers for a specific engine and model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["engine", "model"],
  "properties": {
    "engine": {
      "type": "string",
      "enum": ["sdxl", "flux1", "flux2", "wan-fast", "wan-full", "ltx"],
      "description": "Engine name ('sdxl', 'flux1', 'flux2', 'wan-fast', 'wan-full', 'ltx')"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model filename or identifier"
    }
  }
}
