{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp_video_validate.json",
  "title": "video_validate",
  "description": "Dry-run validation of a video scenario against JSON Schema and timing constraints.",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["scenario_path"] },
    { "required": ["scenes"] }
  ],
  "properties": {
    "scenario_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a base scenario file on disk to validate"
    },
    "name": {
      "type": "string",
      "description": "Human-readable scenario title"
    },
    "image": {
      "$ref": "scenario.json#/$defs/image_root_config"
    },
    "video": {
      "$ref": "scenario.json#/$defs/video_root_config"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "scenario.json#/$defs/scene"
      },
      "description": "Inline montage scenes to validate"
    }
  }
}
