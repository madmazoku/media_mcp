{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp_comfy_flux_txt2img.json",
  "title": "MCP Tool Arguments: comfy_flux_txt2img",
  "description": "Generate high-quality images via FLUX.1 Dev or FLUX.2 Klein in ComfyUI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt"],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Visual descriptive prompt for FLUX"
    },
    "model_type": {
      "type": "string",
      "enum": ["flux1_dev", "flux2"],
      "default": "flux1_dev",
      "description": "FLUX model version: 'flux1_dev' or 'flux2'"
    },
    "width": {
      "type": "integer",
      "minimum": 64,
      "multipleOf": 16,
      "default": 1024,
      "description": "Width (multiple of 16, default 1024)"
    },
    "height": {
      "type": "integer",
      "minimum": 64,
      "multipleOf": 16,
      "default": 1024,
      "description": "Height (multiple of 16, default 1024)"
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 150,
      "description": "Steps (default: 28 for flux1_dev, 30 for flux2)"
    },
    "guidance": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 30.0,
      "default": 3.5,
      "description": "Guidance scale (default: 3.5)"
    },
    "seed": {
      "type": "integer",
      "minimum": -1,
      "default": -1,
      "description": "Seed (-1 for random)"
    },
    "lora_name": {
      "type": "string",
      "minLength": 1,
      "description": "Compatible FLUX.1 LoRA filename (flux1_dev only)"
    },
    "lora_strength": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 2.0,
      "default": 0.8,
      "description": "LoRA strength (default: 0.8)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_type": { "const": "flux2" }
        },
        "required": ["model_type"]
      },
      "then": {
        "not": {
          "required": ["lora_name"]
        }
      }
    }
  ]
}
