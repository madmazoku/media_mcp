{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp_sd_txt2img.json",
  "title": "MCP Tool Arguments: sd_txt2img",
  "description": "Generate images via Automatic1111 WebUI (SDXL, Pony, Illustrious, SD 1.5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt"],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Positive visual prompt"
    },
    "negative_prompt": {
      "type": "string",
      "description": "Negative prompt"
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "description": "Optional checkpoint model name to switch to"
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 150,
      "default": 30,
      "description": "Sampling steps (default: 30)"
    },
    "cfg_scale": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 30.0,
      "default": 7.0,
      "description": "CFG Scale (default: 7.0, or 5.5 for Pony)"
    },
    "width": {
      "type": "integer",
      "minimum": 64,
      "multipleOf": 16,
      "default": 1280,
      "description": "Width (multiple of 16, default: 1280)"
    },
    "height": {
      "type": "integer",
      "minimum": 64,
      "multipleOf": 16,
      "default": 720,
      "description": "Height (multiple of 16, default: 720)"
    },
    "seed": {
      "type": "integer",
      "minimum": -1,
      "default": -1,
      "description": "Seed (-1 for random)"
    },
    "sampler_name": {
      "type": "string",
      "minLength": 1,
      "description": "Sampler name (e.g. 'Euler a')"
    }
  }
}
