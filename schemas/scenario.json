{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.json",
  "title": "Media MCP Video Scenario",
  "description": "Strict hierarchical Scene -> Blocks video scenario schema with technical parameters isolated in root .image and .video configs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["video", "scenes"],
  "properties": {
    "scenario_path": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path to a base scenario file on disk to inherit and overlay from"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable scenario title"
    },
    "image": {
      "$ref": "#/$defs/image_root_config"
    },
    "video": {
      "$ref": "#/$defs/video_root_config"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      },
      "description": "Ordered list of montage scenes"
    }
  },
  "$defs": {
    "image_root_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "model"],
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["sdxl", "flux1", "flux2"],
          "description": "Anchor image generation engine"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model filename or identifier"
        },
        "prompt": {
          "type": "string",
          "description": "Base visual prompt inherited by scene anchor frames"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative prompt (SDXL only)"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "guidance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        },
        "denoise": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0,
          "default": 0.65,
          "description": "Default img2img denoising strength for anchor frames"
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "fit": {
          "type": "string",
          "enum": ["crop", "outpaint"],
          "description": "Fitting strategy when adapting anchor image_path to target scenario resolution ('crop' or 'outpaint')"
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lora_item"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": { "enum": ["flux1", "flux2"] }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["negative_prompt"] },
                { "required": ["cfg"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine": { "const": "flux2" }
            },
            "required": ["engine"]
          },
          "then": {
            "not": {
              "required": ["loras"]
            }
          }
        }
      ]
    },
    "video_root_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "model"],
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["wan-fast", "wan-full", "ltx"],
          "description": "Video generation engine"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Video model or bundle identifier"
        },
        "prompt": {
          "type": "string",
          "description": "Base motion prompt inherited by all blocks"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Base negative prompt inherited by all blocks"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16,
          "default": 832
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 16,
          "default": 480
        },
        "fps": {
          "type": "integer",
          "enum": [16, 24, 25, 30, 60],
          "default": 16
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Global video sampling steps"
        },
        "cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0,
          "description": "Global video Classifier-Free Guidance scale"
        },
        "seed": {
          "type": "integer",
          "minimum": -1,
          "description": "Global video random seed (-1 for randomized)"
        },
        "max_duration": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 60.0,
          "default": 10.0
        },
        "weight_dtype": {
          "type": "string",
          "enum": ["default", "fp8_e4m3fn", "fp8_e5m2"],
          "description": "UNet weight precision mode"
        },
        "ramp_latents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 3,
          "description": "Number of temporal latents for CFG ramp-up after latent prefix"
        },
        "min_cfg": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0,
          "default": 1.0,
          "description": "Initial CFG scale at prefix boundary during temporal CFG ramp-up"
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lora_item"
          }
        }
      }
    },
    "lora_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "LoRA model name or filename"
        },
        "strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "default": 0.8,
          "description": "LoRA weight strength"
        }
      }
    },
    "anchor_image": {
      "oneOf": [
        {
          "type": "object",
          "description": "Ready keyframe on disk to be used directly as video anchor frame (no image generator invocation)",
          "additionalProperties": false,
          "required": ["keyframe_path"],
          "properties": {
            "keyframe_path": {
              "type": "string",
              "minLength": 1,
              "description": "Path to an existing anchor keyframe image on disk. Used directly as initial frame for video generation without invoking the image generator."
            }
          }
        },
        {
          "type": "object",
          "description": "Generated anchor frame via txt2img or img2img through the image engine",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "Visual prompt text describing the scene appearance (combined with global image.prompt)"
            },
            "negative_prompt": {
              "type": "string",
              "description": "Negative prompt (SDXL only, combined with global negative_prompt)"
            },
            "image_path": {
              "type": "string",
              "minLength": 1,
              "description": "Source image on disk for img2img refinement"
            },
            "mask_path": {
              "type": "string",
              "minLength": 1,
              "description": "Optional path to inpainting mask on disk for selective anchor frame refinement (allowed with image_path)"
            },
            "denoise": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1.0,
              "description": "Denoising strength for img2img refinement of this scene's anchor frame (overrides global image.denoise)"
            },
            "fit": {
              "type": "string",
              "enum": ["crop", "outpaint"],
              "description": "Fitting strategy when adapting anchor image_path to target scenario resolution ('crop' or 'outpaint')"
            },
            "loras": {
              "type": "array",
              "description": "Scene-specific LoRAs to merge with global image.loras",
              "items": {
                "$ref": "#/$defs/lora_item"
              }
            }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_prompt"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Descriptive title for this video block"
        },
        "duration": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30.0,
          "default": 5.0,
          "description": "Duration in seconds for this block"
        },
        "overlap": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 5.0,
          "default": 0.0,
          "description": "Tail latent overlap duration into subsequent block"
        },
        "motion_prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Action and camera dynamics prompt"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Block-specific negative prompt"
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lora_item"
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_image", "blocks"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Descriptive scene title"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Scene-level negative prompt"
        },
        "anchor_image": {
          "$ref": "#/$defs/anchor_image"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          },
          "description": "Ordered sequence of motion blocks inside this scene"
        }
      }
    }
  }
}
